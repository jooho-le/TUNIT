{
  "openapi": "3.1.0",
  "info": {
    "title": "TUNIT Backend Foundation",
    "version": "0.1.0",
    "description": "실제 구현된 인증 기반 4개 경로만 기술한다. 가입·취향·추천·초대·관심 업무 API는 미구현이며 기존 프론트 계약과 자동 호환되지 않는다."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/csrf": {
      "get": {
        "summary": "세션 CSRF 획득",
        "description": "익명 요청에도 세션 쿠키를 발급한다. 같은 세션 쿠키와 응답 headerName/token을 변경 요청에 함께 보낸다. 응답은 no-store.",
        "security": [],
        "responses": {
          "200": {
            "description": "성공 DTO 직접 반환",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "JSON 세션 로그인",
        "description": "사전 CSRF·세션 필요. 로그인 후 세션 ID와 CSRF가 변경된다. 가입은 포함하지 않는다.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공 DTO 직접 반환",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "공통 오류 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "공통 오류 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "공통 오류 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "공통 오류 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "공통 오류 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "현재 인증 사용자",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "성공 DTO 직접 반환",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "공통 오류 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "세션 로그아웃",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "responses": {
          "204": {
            "description": "본문 없음, 세션 무효화"
          },
          "401": {
            "description": "공통 오류 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "공통 오류 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID",
        "description": "csrf 획득 시 익명 세션도 가능하며 me/logout은 인증된 세션이어야 한다."
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "description": "실제 사용할 헤더명은 GET /auth/csrf의 headerName을 따른다."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "description": "비밀번호 가입 정책은 확정하지 않는다. 로그인 입력은 공백 문자열을 허용하지 않는다."
      },
      "AuthUserResponse": {
        "type": "object",
        "required": [
          "id",
          "nickname",
          "tasteStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          },
          "tasteStatus": {
            "type": "string",
            "enum": [
              "INCOMPLETE",
              "COMPLETE"
            ]
          }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "required": [
          "token",
          "headerName"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        }
      },
      "FieldErrorDetail": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "fieldErrors",
          "timestamp",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDetail"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string",
            "description": "쿼리 제외, 초대 토큰은 {token}으로 마스킹"
          }
        }
      },
      "PageResponse": {
        "type": "object",
        "description": "공통 DTO의 제네릭 구조. 해당하는 업무 목록 API는 아직 구현하지 않았다.",
        "required": [
          "items",
          "page",
          "size",
          "totalElements"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {}
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
