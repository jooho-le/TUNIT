  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID",
        "description": "csrf 획득 시 익명 세션도 가능하며 me/logout은 인증된 세션이어야 한다."
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "description": "실제 사용할 헤더명은 GET /auth/csrf의 headerName을 따른다."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "description": "비밀번호 가입 정책은 확정하지 않는다. 로그인 입력은 공백 문자열을 허용하지 않는다."
      },
      "AuthUserResponse": {
        "type": "object",
        "required": [
          "id",
          "nickname",
          "tasteStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          },
          "tasteStatus": {
            "type": "string",
            "enum": [
              "INCOMPLETE",
              "COMPLETE"
            ]
          }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "required": [
          "token",
          "headerName"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        }
      },
      "FieldErrorDetail": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "fieldErrors",
          "timestamp",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDetail"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string",
            "description": "쿼리 제외, 초대 토큰은 {token}으로 마스킹"
          }
        }
      },
      "PageResponse": {
        "type": "object",
        "description": "공통 DTO의 제네릭 구조. 해당하는 업무 목록 API는 아직 구현하지 않았다.",
        "required": [
          "items",
          "page",
          "size",
          "totalElements"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {}
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "writeOnly": true,
            "description": "Unicode 코드 포인트 8자 이상, UTF-8 72바이트 이하. 입력값을 trim하지 않는다."
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "앞뒤 공백 제거 후 검증"
          }
        },
        "required": [
          "email",
          "password",
          "nickname"
        ]
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
